    {
      "name": "User Management",
      "item": [
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newteacher@example.com\",\n  \"name\": \"New Teacher\",\n  \"role\": \"TEACHER\",\n  \"profileData\": {\n    \"phoneNumber\": \"+123456789\",\n    \"employeeId\": \"TEACH-002\",\n    \"departmentId\": \"{{departmentId}}\",\n    \"designation\": \"Assistant Professor\",\n    \"qualification\": \"PhD\",\n    \"joiningDate\": \"2023-01-15\"\n  },\n  \"sendEmail\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "Create a new user (admin only)"
          },
          "response": []
        },
        {
          "name": "Create Student User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newstudent@example.com\",\n  \"name\": \"New Student\",\n  \"role\": \"STUDENT\",\n  \"profileData\": {\n    \"phoneNumber\": \"+123456789\",\n    \"registrationNumber\": \"2023-CS-102\",\n    \"departmentId\": \"{{departmentId}}\",\n    \"programId\": \"{{programId}}\",\n    \"batchId\": \"{{batchId}}\",\n    \"sectionId\": \"{{sectionId}}\",\n    \"currentSemester\": 1,\n    \"enrollmentDate\": \"2023-09-01\"\n  },\n  \"sendEmail\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "Create a new student user"
          },
          "response": []
        },
        {
          "name": "Get Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users?role=STUDENT&departmentId={{departmentId}}&page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ],
              "query": [
                {
                  "key": "role",
                  "value": "STUDENT",
                  "description": "Filter by role"
                },
                {
                  "key": "departmentId",
                  "value": "{{departmentId}}",
                  "description": "Filter by department"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Items per page"
                }
              ]
            },
            "description": "Get users with filtering options"
          },
          "response": []
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{userId}}\",\n  \"name\": \"Updated Name\",\n  \"email\": \"updated@example.com\",\n  \"phoneNumber\": \"+987654321\",\n  \"active\": true,\n  \"profileData\": {\n    \"sectionId\": \"{{sectionId}}\",\n    \"currentSemester\": 2\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "Update an existing user"
          },
          "response": []
        },
        {
          "name": "Bulk Import Users",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"users\": [\n    {\n      \"email\": \"student1@example.com\",\n      \"name\": \"Student One\",\n      \"role\": \"STUDENT\",\n      \"profileData\": {\n        \"registrationNumber\": \"2023-CS-103\",\n        \"departmentId\": \"{{departmentId}}\",\n        \"programId\": \"{{programId}}\",\n        \"batchId\": \"{{batchId}}\",\n        \"currentSemester\": 1,\n        \"enrollmentDate\": \"2023-09-01\"\n      }\n    },\n    {\n      \"email\": \"student2@example.com\",\n      \"name\": \"Student Two\",\n      \"role\": \"STUDENT\",\n      \"profileData\": {\n        \"registrationNumber\": \"2023-CS-104\",\n        \"departmentId\": \"{{departmentId}}\",\n        \"programId\": \"{{programId}}\",\n        \"batchId\": \"{{batchId}}\",\n        \"currentSemester\": 1,\n        \"enrollmentDate\": \"2023-09-01\"\n      }\n    }\n  ],\n  \"sendEmails\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "Import multiple users at once"
          },
          "response": []
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users?id={{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ],
              "query": [
                {
                  "key": "id",
                  "value": "{{userId}}",
                  "description": "User ID to delete"
                }
              ]
            },
            "description": "Delete a user"
          },
          "response": []
        }
      ],
      "description": "User creation, retrieval, updating, and deletion"
