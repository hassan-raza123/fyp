  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Store token if login request",
          "if (pm.request.url.toString().includes('/api/auth/login') && pm.response.code === 200) {",
          "    var jsonData = pm.response.json();",
          "    if (jsonData && jsonData.token) {",
          "        pm.environment.set('token', jsonData.token);",
          "        console.log('Token saved successfully');",
          "    }",
          "}",
          "",
          "// Store IDs from responses for later use",
          "if (pm.response.code === 200 || pm.response.code === 201) {",
          "    var jsonData = pm.response.json();",
          "    ",
          "    // Department",
          "    if (jsonData.id && pm.request.url.toString().includes('/api/departments') && pm.request.method === 'POST') {",
          "        pm.environment.set('departmentId', jsonData.id);",
          "    }",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ]
}
