# Environment
NODE_ENV="development"

# Database
DATABASE_URL="mysql://user:password@host:port/dbname?ssl-mode=REQUIRED"

# JWT Authentication
# REQUIRED. Must be at least 32 characters — the app refuses to start without it.
# Generate one with: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_here_min_32_chars

# Cron authentication
# REQUIRED in production for /api/cron/*. Vercel Cron sends this as
# `Authorization: Bearer <CRON_SECRET>`. Without it the endpoint returns 503.
# Generate one with: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

# Email — SMTP (production)
#
# Any provider. Set these and the Gmail fallback below is ignored.
# MAIL_FROM must be on a domain you control, with SPF, DKIM and DMARC set up —
# mail whose From: disagrees with the sending domain fails DMARC and is filtered,
# which silently breaks password reset and OTP sign-in.
# Port 465 uses implicit TLS; 587 upgrades with STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="no-reply@your-domain.com"

# Email — Gmail (development fallback, DEPRECATED)
#
# Used only when SMTP_HOST is unset. App passwords get throttled and the mail
# lands in spam once volume picks up, so this must not be the production path.
# The app logs a warning if it falls back to this in production.
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD="your gmail app password"

# Application URL (for password reset links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# First super admin, created by `npm run seed`.
# SEED_ADMIN_EMAIL is REQUIRED — the seed refuses to run without it, so that
# provisioning an installation never leaves a stranger's account in it.
SEED_ADMIN_EMAIL=admin@your-institution.edu.pk
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Administrator
# Optional. A random password is generated and printed once if unset.
# SEED_ADMIN_PASSWORD=
