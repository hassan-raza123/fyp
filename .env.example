# Environment
NODE_ENV="development"

# Database
DATABASE_URL="mysql://user:password@host:port/dbname?ssl-mode=REQUIRED"

# JWT Authentication
# REQUIRED. Must be at least 32 characters — the app refuses to start without it.
# Generate one with: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_here_min_32_chars

# Cron authentication
# REQUIRED in production for /api/cron/*. Vercel Cron sends this as
# `Authorization: Bearer <CRON_SECRET>`. Without it the endpoint returns 503.
# Generate one with: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

# Email Configuration (Gmail)
#
# NOTE: Gmail is a development convenience, not a production mail path. App
# passwords get throttled and the mail lands in spam once volume picks up, which
# breaks password resets and OTP sign-in. Move to a real sending provider on a
# domain you own, with SPF/DKIM/DMARC, before the first paying customer.
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD="your gmail app password"

# Application URL (for password reset links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# First super admin, created by `npm run seed`.
# SEED_ADMIN_EMAIL is REQUIRED — the seed refuses to run without it, so that
# provisioning an installation never leaves a stranger's account in it.
SEED_ADMIN_EMAIL=admin@your-institution.edu.pk
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Administrator
# Optional. A random password is generated and printed once if unset.
# SEED_ADMIN_PASSWORD=
