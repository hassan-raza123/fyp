# Environment
NODE_ENV="development"

# Database
DATABASE_URL="mysql://user:password@host:port/dbname?ssl-mode=REQUIRED"

# JWT Authentication
# REQUIRED. Must be at least 32 characters — the app refuses to start without it.
# Generate one with: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_here_min_32_chars

# Cron authentication
# REQUIRED in production for /api/cron/*. Vercel Cron sends this as
# `Authorization: Bearer <CRON_SECRET>`. Without it the endpoint returns 503.
# Generate one with: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

# Email Configuration (Gmail)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD="your gmail app password"

# Application URL (for password reset links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
